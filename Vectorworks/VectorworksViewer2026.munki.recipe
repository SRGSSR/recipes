<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Description</key>
	<string>Imports the Vectorworks 2026 Install Manager into Munki as a Viewer installer. The postinstall script runs the Install Manager CLI with serial "VIEWER", which downloads and installs only the Viewer feature set (about 3.8 GB) from release.vectorworks.net at install time. Clients therefore need direct access to release.vectorworks.net. The munki item version is the Vectorworks build version from versioninfo.json, which matches CFBundleVersion of the installed application.</string>
	<key>Identifier</key>
	<string>com.github.SRGSSR.munki.VectorworksViewer2026</string>
	<key>Input</key>
	<dict>
		<key>MUNKI_REPO_SUBDIR</key>
		<string>apps/%NAME%</string>
		<key>NAME</key>
		<string>VectorworksViewer2026</string>
		<key>pkginfo</key>
		<dict>
			<key>catalogs</key>
			<array>
				<string>testing</string>
			</array>
			<key>description</key>
			<string>The Vectorworks Viewer is a free application that enables those who do not own Vectorworks to open and print projects created in Vectorworks 2026.</string>
			<key>developer</key>
			<string>Vectorworks</string>
			<key>display_name</key>
			<string>Vectorworks Viewer 2026</string>
			<key>installer_type</key>
			<string>copy_from_dmg</string>
			<key>items_to_copy</key>
			<array>
				<dict>
					<key>destination_path</key>
					<string>/private/tmp</string>
					<key>source_item</key>
					<string>Vectorworks 2026 Install Manager.app</string>
				</dict>
			</array>
			<key>minimum_os_version</key>
			<string>12.0</string>
			<key>name</key>
			<string>%NAME%</string>
			<key>postinstall_script</key>
			<string>#!/bin/sh
IM="/private/tmp/Vectorworks 2026 Install Manager.app"
CLI="$IM/Contents/Resources/cli.sh"

TARGET_UID=$(/usr/bin/stat -f %u /dev/console)
TARGET_GID=$(/usr/bin/stat -f %g /dev/console)
if [ "$TARGET_UID" -eq 0 ]; then
    for HOMEDIR in /Users/*; do
        OWNER_UID=$(/usr/bin/stat -f %u "$HOMEDIR")
        if [ "$OWNER_UID" -ge 501 ]; then
            TARGET_UID=$OWNER_UID
            TARGET_GID=$(/usr/bin/stat -f %g "$HOMEDIR")
            break
        fi
    done
fi

"$CLI" -S VIEWER -I "/Applications/Vectorworks 2026 Viewer" install -u "$TARGET_UID" -g "$TARGET_GID"
RESULT=$?

/bin/rm -rf "$IM"
exit $RESULT
</string>
			<key>unattended_install</key>
			<true/>
			<key>uninstall_method</key>
			<string>uninstall_script</string>
			<key>uninstall_script</key>
			<string>#!/bin/sh
/bin/rm -rf "/Applications/Vectorworks 2026 Viewer"
/bin/rm -rf "/Library/Application Support/Vectorworks 2026"
exit 0
</string>
			<key>uninstallable</key>
			<true/>
		</dict>
	</dict>
	<key>MinimumVersion</key>
	<string>1.0.0</string>
	<key>ParentRecipe</key>
	<string>com.github.SRGSSR.download.VectorworksViewer2026</string>
	<key>Process</key>
	<array>
		<dict>
			<key>Arguments</key>
			<dict>
				<key>dmg_path</key>
				<string>%RECIPE_CACHE_DIR%/%NAME%-%version%.dmg</string>
				<key>dmg_root</key>
				<string>%RECIPE_CACHE_DIR%/unzipped</string>
			</dict>
			<key>Processor</key>
			<string>DmgCreator</string>
		</dict>
		<dict>
			<key>Arguments</key>
			<dict>
				<key>additional_pkginfo</key>
				<dict>
					<key>installs</key>
					<array>
						<dict>
							<key>CFBundleVersion</key>
							<string>%version%</string>
							<key>path</key>
							<string>/Applications/Vectorworks 2026 Viewer/Vectorworks 2026.app</string>
							<key>type</key>
							<string>application</string>
							<key>version_comparison_key</key>
							<string>CFBundleVersion</string>
						</dict>
					</array>
				</dict>
			</dict>
			<key>Processor</key>
			<string>MunkiPkginfoMerger</string>
		</dict>
		<dict>
			<key>Arguments</key>
			<dict>
				<key>additional_makepkginfo_options</key>
				<array>
					<string>--pkgvers</string>
					<string>%version%</string>
				</array>
				<key>pkg_path</key>
				<string>%dmg_path%</string>
				<key>repo_subdirectory</key>
				<string>%MUNKI_REPO_SUBDIR%</string>
			</dict>
			<key>Processor</key>
			<string>MunkiImporter</string>
		</dict>
	</array>
</dict>
</plist>
